{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicklab.local/schemas/asset-manifest.schema.json",
  "title": "KickLab local 3D asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "version", "status", "artifact", "provenance", "license", "runtime", "validation", "network"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assetId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "status": { "enum": ["evaluation-only", "approved-production"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^src/assets/3d/.+\\.glb$" },
        "mediaType": { "const": "model/gltf-binary" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "sourceType", "sourcePath", "sourceCommit", "acquiredOn", "externalInputs", "likeness", "cloudProcessing"],
      "properties": {
        "creator": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["self-authored-placeholder", "self-authored-production", "official-core-derived"] },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "acquiredOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "externalInputs": { "type": "boolean" },
        "likeness": { "const": false },
        "cloudProcessing": { "const": false }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "basis", "permittedUse", "thirdPartyRestrictions", "proof"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "basis": { "enum": ["self-authored", "cc0-official-core"] },
        "permittedUse": { "enum": ["internal-evaluation", "production-game"] },
        "thirdPartyRestrictions": { "const": "none" },
        "proof": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threeVersion", "loader", "requiredExtensions"],
      "properties": {
        "threeVersion": { "const": "0.186.1" },
        "loader": { "const": "GLTFLoader" },
        "requiredExtensions": { "type": "array", "maxItems": 0 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedIssues"],
      "properties": {
        "allowedIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "severity", "count", "reason"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
              "severity": { "type": "integer", "minimum": 1, "maximum": 3 },
              "count": { "type": "integer", "minimum": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeRequests", "externalUrisAllowed"],
      "properties": {
        "runtimeRequests": { "enum": ["none", "same-origin-local-only"] },
        "externalUrisAllowed": { "const": false }
      }
    }
  }
}
