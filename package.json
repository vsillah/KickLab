{
  "name": "kicklab",
  "version": "1.0.0",
  "private": true,
  "description": "KickLab: a physics game for kids. Fight, race and soccer labs where the math is the controller.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets:validate": "node scripts/validate-3d-assets.mjs",
    "vendor:three": "node scripts/vendor-three-runtime.mjs",
    "qa:3d-compat": "node scripts/qa-stage1-3d-compat.mjs",
    "qa:direction-c": "node scripts/qa-direction-c-athlete.mjs",
    "qa:multi-activity-athlete": "node scripts/qa-multi-activity-athlete.mjs",
    "qa:match-visual-coherence": "node scripts/qa-match-visual-coherence.mjs",
    "qa:live-physics-combo": "node scripts/qa-live-physics-combo.mjs",
    "qa:fight-controller-safety": "node scripts/qa-fight-controller-safety.mjs",
    "qa:near-stand": "node scripts/qa-near-stand.mjs",
    "qa:race-comparative": "node scripts/qa-race-comparative.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "pages:check": "node scripts/check-pages-prepare.mjs",
    "mobile:prepare": "node scripts/build.mjs --emit-game && node scripts/prepare-mobile.mjs",
    "mobile:check": "npm run mobile:prepare && node --test tests/mobile-foundation.test.mjs",
    "test": "node --test",
    "check": "node scripts/build.mjs --emit-game && node scripts/validate-3d-assets.mjs && node scripts/prepare-pages.mjs && node scripts/prepare-mobile.mjs && node --check dist/game.js && node --test && node scripts/check-web.mjs && node scripts/check-pages-prepare.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "three": "0.186.1"
  },
  "engines": {
    "node": ">=22"
  }
}
